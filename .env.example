# Local-only credentials for the tools in scripts/. Copy to .env and fill in.
# .env is gitignored. NEVER commit a real value.
#
# The SERVER reads its own settings from the environment too; the full list,
# with defaults and explanations, is in server/.env.example. The server keys
# repeated here are the ones that are convenient to keep in one local file
# when you run the game behind a cloudflared tunnel on this machine.

# --- Figma (scripts/figma-rest.mjs) ----------------------------------------
# Personal access tokens, used round-robin one per call so a 429 on one falls
# through to the next. Create them at figma.com > Settings > Personal access
# tokens. Only the first is required.
FIGMA_ACCESS_TOKEN=
FIGMA_ACCESS_TOKEN_2=
FIGMA_ACCESS_TOKEN_3=

# --- Word stats (scripts/pull-stats.mjs) -----------------------------------
# STATS_URL is the deployed origin; STATS_TOKEN is the same value the server
# runs with (Render generates it: Environment tab).
STATS_URL=
STATS_TOKEN=

# --- Private-beta lock (server) --------------------------------------------
# ACCESS_CODE turns the gate on. ACCESS_SECRET signs the cookie: set it, or a
# new random key is generated at every boot and everyone types the code again.
# Never leave it unset in a long-running deployment.
ACCESS_CODE=
ACCESS_SECRET=

# --- TURN relay (server, optional) -----------------------------------------
# Cloudflare Realtime TURN. The API token and the analytics token must never
# reach a browser; the server mints short-lived credentials from them.
TURN_CF_KEY_ID=
TURN_CF_API_TOKEN=
TURN_CF_ACCOUNT_ID=
TURN_CF_ANALYTICS_TOKEN=

# --- Proxy trust (server) --------------------------------------------------
# `loopback` for a cloudflared tunnel on this machine, `cloudflare` on Render
# behind a proxied Cloudflare domain, `0` for a directly exposed server.
TRUST_PROXY=0
