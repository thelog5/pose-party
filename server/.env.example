# Pose Charades server configuration. All values optional; defaults shown.
PORT=3000
# Comma-separated browser origins allowed to connect cross-origin.
# Same-origin (the game served by this server) always works.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ROUNDS=999
MATCH_MS=120000
WORD_MS=20000
PRECOUNT_MS=3000
TUTORIAL_TIMEOUT_MS=15000
BETWEEN_ROUNDS_MS=1800
# Arrival grace for synchronized recognition timestamps. These values do not
# extend the visible scoring/chase windows.
CLAIM_GRACE_MS=600
CLAIM_FUTURE_SKEW_MS=900
ROOM_TTL_MS=1800000
MAX_ROOMS=500
