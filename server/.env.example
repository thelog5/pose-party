# Pose Charades server configuration. All values optional; defaults shown.
PORT=3000
# Comma-separated browser origins allowed to connect cross-origin.
# Same-origin (the game served by this server) always works.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ROUNDS=5
WORD_MS=20000
PRECOUNT_MS=3000
BETWEEN_ROUNDS_MS=1800
ROOM_TTL_MS=1800000
MAX_ROOMS=500
