# Pose Charades server configuration. All values optional; defaults shown.
PORT=3000
# Comma-separated browser origins allowed to connect cross-origin.
# Same-origin (the game served by this server) always works.

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ROUNDS=999
MATCH_MS=120000
WORD_MS=20000
PRECOUNT_MS=3000
# HOW TO PLAY is a grace, not a barrier: everyone gets this long to read the
# card and then the match starts whether or not they pressed anything. Readying
# up early releases the room immediately.
TUTORIAL_GRACE_MS=6000
BETWEEN_ROUNDS_MS=1800
# Arrival grace for synchronized recognition timestamps. These values do not
# extend the visible scoring/chase windows.
CLAIM_GRACE_MS=600
CLAIM_FUTURE_SKEW_MS=900
ROOM_TTL_MS=1800000
MAX_ROOMS=500
# Per-IP token buckets, refilled every 60s. Both are keyed by IP, so two tabs
# on one machine share a bucket and a household behind one NAT is a single
# key. Walking into a lobby CREATES a room, so rateCreate is a gameplay knob,
# not just abuse protection — set it too low and going in and out of lobbies
# leaves the invite code stuck at `------`.
RATE_CREATE=30
RATE_JOIN=60

# SET THIS TO 1 IN PRODUCTION, and only in production. Render, Railway and Fly
# terminate TLS in front of this process, so without it every player looks
# like the platform proxy and the whole player base shares ONE bucket of
# RATE_CREATE rooms per minute. Leave it off on a directly-exposed server:
# X-Forwarded-For is client-writable, and trusting it there hands an abuser
# unlimited fresh rate-limit keys.
TRUST_PROXY=0

# Cache lifetime in seconds for assets/ only. The art is ~30 MB over 275
# files and is stable between deploys. Markup, JS and CSS are never cached
# this way: they are not content-hashed, so players would be stranded on a
# stale build after a deploy.
STATIC_MAX_AGE=2592000

# ---------------------------------------------------------------------------
# PRIVATE BETA LOCK (optional; unset means the game is open, as it shipped)
#
# One shared code in front of an unreleased build. It gates the page AND the
# Socket.IO handshake, so nobody reaches the game API by skipping the page.
# /healthz stays open, because the platform health check must not need a
# password.
#
# It is a cookie rather than HTTP basic auth on purpose: the client upgrades
# from polling to WebSocket, and browsers do not reliably send basic-auth
# credentials on a WebSocket handshake. That would load the page and then kill
# every online match at the upgrade.
#
# Share the code out of band. Change it to revoke everyone at once; wrong
# guesses are capped at 10 per IP per minute.
# ACCESS_CODE=
# ACCESS_SECRET=          # only to expire live cookies without changing the code
# ACCESS_TTL_SEC=2592000  # 30 days

# ---------------------------------------------------------------------------
# TURN (optional; unset means STUN only, exactly as the game shipped)
#
# A RELAY IS NOT AN SFU. WebRTC media is DTLS-SRTP encrypted between the two
# browsers, so a TURN server forwards packets it holds no key for and cannot
# see the video. An SFU terminates the encryption and can. This game will
# never have an SFU; TURN is safe for the same reason.
#
# What TURN buys is REACH and nothing else. It does NOT reduce anyone's
# upload: a mesh allocates one relay per link, so six players still send five
# streams each. It rescues the pairs STUN cannot hole-punch: symmetric NAT,
# carrier-grade NAT on mobile, corporate and campus firewalls, blocked UDP.
#
# Read your own logs before turning it on. Every `net ... failed` line is a
# pair a relay would have rescued; count those against the `connected` lines.
#
# CLOUDFLARE does NOT implement the shared-secret scheme below. It mints
# credentials from its own API, so it takes a key id and an API token and no
# TURN_URLS at all: the endpoint returns the urls too. Setting both selects
# it. The result is cached and refreshed at 75% of its life, so a player is
# never handed a credential that expires mid-match, and a mint that fails
# serves STUN only rather than holding up the lobby.
# TURN_CF_KEY_ID=
# TURN_CF_API_TOKEN=
#
# TTL IS CAPPED AT 48 HOURS by Cloudflare (172800). The 12h default is fine;
# a larger value is rejected and the mint fails to STUN only.
#
# THE SPEND CAP. Cloudflare gives 1000 GB of TURN egress free (shared with the
# Realtime SFU) and then bills $0.05/GB. Nothing in a TURN key stops itself, so
# the server reads its own usage back out of Cloudflare's analytics API and
# stops serving relay credentials before the allowance runs out.
#
# IT FAILS CLOSED. A budget with no analytics credentials, a query that has
# never succeeded, or a reading gone stale all serve STUN only, because being
# wrong in that direction costs a few players a relay and being wrong in the
# other direction costs money. Set TURN_CF_BUDGET_GB=0 to lift the cap.
#
# The analytics token is a SECOND, separate token: My Profile > API Tokens,
# with the Account Analytics read permission. The TURN key's own 64-char token
# does not work here, and this one must never reach a browser.
# TURN_CF_BUDGET_GB=900
# TURN_CF_ACCOUNT_ID=
# TURN_CF_ANALYTICS_TOKEN=
#
# Usage is counted from the start of the current UTC month, which is how
# Cloudflare bills everything else. Cloudflare does NOT document whether the
# free 1000 GB resets monthly. If it turns out to be a once-ever allowance,
# pin a fixed date here and the count never resets.
# TURN_CF_BUDGET_SINCE=2026-09-01
# TURN_CF_BUDGET_POLL_MS=300000
# TURN_CF_BUDGET_STALE_MS=1800000
#
# Everything below is for coturn and for providers that implement the TURN
# REST API. Ignore it if you are on Cloudflare.
#
# TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:5349
#
# Prefer the shared secret: the server signs a short-lived username so the
# browser never holds a lasting credential. This is the TURN REST API, which
# coturn implements as `use-auth-secret`.
# TURN_SECRET=a-long-random-string-also-in-turnserver.conf
# TURN_TTL_SEC=43200
#
# Only for providers that issue a fixed pair. Weaker: it reaches every client
# as-is and cannot expire.
# TURN_USERNAME=
# TURN_PASSWORD=
#
# TURN_URLS set with NEITHER scheme disables TURN rather than serving an open
# relay, which scanners find within days and use as a free proxy.

# STUN_URLS=stun:stun.l.google.com:19302
